{
  // Bogey Club als Cloudflare Worker. Wird bei jedem Push auf main über Workers Builds veröffentlicht.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bogeyclub",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Datenbank und Bildspeicher werden beim ersten Deploy automatisch angelegt (Wrangler ≥ 4.45).
  "d1_databases": [{ "binding": "DB", "database_name": "bogeyclub" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "bogeyclub-photos" }],
  "vars": {
    // Cloudflare Access: Team-Name (xyz aus xyz.cloudflareaccess.com) und Application Audience (AUD) Tag.
    // Solange beide leer sind, bleibt die App geschlossen.
    "ACCESS_TEAM": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
